# Keeps the build context small and avoids copying secrets/artifacts.
# Everything here is excluded from what Docker sends to the daemon at build time.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tests and coverage — don't go into the runtime image
tests/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
requirements-dev.txt

# Secrets and local environment (never go into the image)
.env
*.env

# Tools
.git/
.gitignore
Dockerfile
.dockerignore
