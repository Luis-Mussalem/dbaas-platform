# =============================================================================
#  DBaaS Platform — environment template
#
#  Quick start:  cp .env.example .env  &&  docker compose up -d --build
#
#  ⚠️  DEMO / DEV ONLY.  The secrets below are throwaway values that ship with
#  the repo so the project runs out of the box against fictional local data.
#  They protect NOTHING real. Before hosting this anywhere, regenerate every
#  key/password (one-liners are shown next to each field).
# =============================================================================

# === Application ===
APP_NAME=DBaaS Platform
APP_VERSION=0.1.0
DEBUG=true

# === Database (PostgreSQL) ===
POSTGRES_USER=dbaas
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=vh3i8S7zRCbsSW4Z_bVOoB5J73TzcmZM
POSTGRES_DB=dbaas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed internally by pydantic-settings:
# DATABASE_URL=postgresql+psycopg://dbaas:<password>@localhost:5432/dbaas

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@dbaas.dev
PGADMIN_DEFAULT_PASSWORD=OwquyofVDb6COmh4

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# === JWT ===
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=s0MObyofUfz0erw5raKZo5Bc23RyDfGbe5VVuHJFa7zK_XKAE40WyZVsVT8ohJJw
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Encryption (Fernet) ===
# Must be a valid 32-byte url-safe base64 key, or the app fails at startup.
# regenerate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=alspGn4CWfeXr6sbM9Ey11klTviE0_uBzqySb96z05A=

# === Registration ===
REGISTRATION_ENABLED=false

# === Alerts ===
# URL para receber webhooks quando um alerta dispara ou é resolvido.
# Deixar comentado para usar apenas logs (sem webhook).
# Aceita qualquer endpoint HTTP POST que receba JSON.
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/alerts

# === Provisioning (Docker) ===
# Senha do superuser 'postgres' dentro de cada container provisionado.
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVISIONER_SUPERUSER_PASSWORD=dmL0ApohsicqVDBM-GeDT9mWEwf4uZxB

# === Demo mode (simulação de uso) ===
# Expõe /api/v1/demo e o botão "Simular uso" na UI. NADA roda sozinho: até o
# usuário clicar, a frota demo é 100% real (containers de verdade, sem histórico
# fabricado). O roteiro então gera tráfego, dispara alerta, roda backup e
# manutenção — e um banner avisa enquanto houver dado simulado no banco.
# DEMO_MODE=false: endpoints respondem 404 e os loops de demo não sobem.
DEMO_MODE=true
# Aceleração do tempo durante a simulação: 144 → a curva diária de tráfego (24h)
# se desenha em 10 minutos, que é o tempo de uma visita.
DEMO_SIMULATION_SPEED_FACTOR=144
DEMO_WORKLOAD_INTERVAL_SECONDS=15
# Teto de conexões por instância de produção (staging usa ~metade). Cada conexão
# é um backend PostgreSQL (~10 MB) — baixe para 6 em máquinas modestas.
DEMO_WORKLOAD_MAX_CONNECTIONS=14
# Cadência do poller de métricas. O default do código é 60s (produção); a demo
# usa 15s para o dashboard — queries/s, conexões, latência — atualizar de forma
# viva em vez de saltar a cada minuto.
METRICS_POLL_INTERVAL_SECONDS=15

# gid do grupo `docker` no host, usado pelo compose (group_add) para dar ao
# container do backend acesso ao /var/run/docker.sock. Descubra o seu com:
#   getent group docker
# Só necessário ao rodar o backend via docker compose (não no uvicorn no host).
DOCKER_GID=999

# uid/gid do seu usuário no host. O container do backend roda com eles para
# conseguir escrever no ./data montado (backups/WAL). Descubra com: id -u / id -g
# Default 1000:1000 cobre o caso single-user comum. Só usado no docker compose.
HOST_UID=1000
HOST_GID=1000
