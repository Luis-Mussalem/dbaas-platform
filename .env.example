# =============================================================================
#  DBaaS Platform — environment template
#
#  Quick start:  cp .env.example .env  &&  docker compose up -d --build
#
#  ⚠️  DEMO / DEV ONLY.  The secrets below are throwaway values that ship with
#  the repo so the project runs out of the box against fictional local data.
#  They protect NOTHING real.
#
#  Before hosting this anywhere reachable, all four of these:
#    1. regenerate every key/password below (one-liners next to each field);
#    2. set DEMO_MODE=false      — otherwise a superuser whose password is
#                                  published in the README is created for you;
#    3. set COOKIE_SECURE=true   — session cookies must carry `Secure` on HTTPS;
#    4. keep REGISTRATION_ENABLED=false and create the first account by
#       registering it once; it becomes the superuser and the endpoint closes.
# =============================================================================

# === Application ===
APP_NAME=DBaaS Platform
APP_VERSION=1.0.1
DEBUG=true

# === Database (PostgreSQL) ===
POSTGRES_USER=dbaas
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=vh3i8S7zRCbsSW4Z_bVOoB5J73TzcmZM
POSTGRES_DB=dbaas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed internally by pydantic-settings:
# DATABASE_URL=postgresql+psycopg://dbaas:<password>@localhost:5432/dbaas

# === pgAdmin ===
PGADMIN_DEFAULT_EMAIL=admin@dbaas.dev
PGADMIN_DEFAULT_PASSWORD=OwquyofVDb6COmh4

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# === JWT ===
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=s0MObyofUfz0erw5raKZo5Bc23RyDfGbe5VVuHJFa7zK_XKAE40WyZVsVT8ohJJw
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Encryption (Fernet) ===
# Must be a valid 32-byte url-safe base64 key, or the app fails at startup.
# regenerate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=alspGn4CWfeXr6sbM9Ey11klTviE0_uBzqySb96z05A=

# === Session cookies ===
# Forces the `Secure` flag on the auth cookies. Leave false for local http://
# development. Set it to TRUE in any deployment served over HTTPS — especially
# behind a reverse proxy that terminates TLS, where the backend is reached over
# plain HTTP and cannot infer it from the request alone.
COOKIE_SECURE=false

# === Registration ===
# false: POST /auth/register only answers while the users table is EMPTY. That
#   first account is promoted to platform superuser (the bootstrap of a fresh
#   install); every later registration gets 403, so a public deployment can't be
#   joined by strangers.
# true: open registration. New accounts are created with NO company and see
#   nothing until an admin assigns one.
REGISTRATION_ENABLED=false

# === Alerts ===
# URL to receive webhooks when an alert fires or is resolved.
# Leave commented to use logs only (no webhook).
# Accepts any HTTP POST endpoint that receives JSON.
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/alerts

# === Provisioning (Docker) ===
# Password for the 'postgres' superuser inside each provisioned container.
# regenerate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROVISIONER_SUPERUSER_PASSWORD=dmL0ApohsicqVDBM-GeDT9mWEwf4uZxB

# === Demo mode (always-live demo fleet) ===
# true (the default) makes this a PORTFOLIO deployment:
#   - the seed provisions the demo fleet (3 fictional companies × prod/staging)
#     and backfills the history a five-minute visit can't produce — 24h of
#     metrics, 30-day uptime, weeks of backups, alert and maintenance timelines;
#   - a continuous baseline load keeps the live numbers moving;
#   - the `dev-test@local.dev` superuser is seeded by its migration, with the
#     password published in the README;
#   - the UI shows a persistent notice and an "About this demo" page at /demo
#     (that half is driven by the build-time NEXT_PUBLIC_DEMO_MODE).
#
# DEMO_MODE=false makes it a REAL deployment: no seeded fleet, no synthetic load,
# and — this is the one that matters — NO demo superuser. The first account is
# then created by registering it (see REGISTRATION_ENABLED above), which promotes
# it to superuser and locks the endpoint behind it.
#
# Never run a publicly reachable deployment with DEMO_MODE=true: the demo account
# and its password are documented in a public repository.
DEMO_MODE=true
# Load generator cadence, in seconds.
DEMO_WORKLOAD_INTERVAL_SECONDS=5
# Connection ceiling per production instance (staging uses ~half). Each connection
# is a PostgreSQL backend (~10 MB) — lower to 6 on modest machines.
DEMO_WORKLOAD_MAX_CONNECTIONS=14
# Metrics poller cadence. The code's default is 60s (production); the demo
# uses 15s so the dashboard — queries/s, connections, latency — updates
# live instead of jumping every minute.
METRICS_POLL_INTERVAL_SECONDS=15

# gid of the `docker` group on the host, used by compose (group_add) to give the
# backend container access to /var/run/docker.sock. Find yours with:
#   getent group docker
# Only needed when running the backend via docker compose (not uvicorn on the host).
DOCKER_GID=999

# uid/gid of your host user. The backend container runs as them so it
# can write to the mounted ./data (backups/WAL). Find yours with: id -u / id -g
# Default 1000:1000 covers the common single-user case. Only used by docker compose.
HOST_UID=1000
HOST_GID=1000
